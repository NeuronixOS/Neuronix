#!/bin/sh
# Smart Escape for Neuronix Hyprland:
#  - fuzzel open → dismiss the launcher
#  - slurp (screenshot region) open → cancel the selection
#  - neuronix settings / waybar popovers open → close them (layer-shell
#    surfaces never receive sendshortcut)
#  - otherwise → forward Escape to the focused window (global bind would
#    otherwise swallow Escape for every app)
set -eu

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"
_uid="$(id -u)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${_uid}}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -d "${XDG_RUNTIME_DIR}/hypr" ]; then
	HYPRLAND_INSTANCE_SIGNATURE="$(
		find "${XDG_RUNTIME_DIR}/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | head -n1
	)"
	export HYPRLAND_INSTANCE_SIGNATURE
fi

if pgrep -x fuzzel >/dev/null 2>&1; then
	pkill -x fuzzel >/dev/null 2>&1 || true
	exit 0
fi

# slurp is a layer-shell overlay, not the focused window, so sendshortcut
# never reaches it. Killing slurp is the same as its own Escape cancel.
if pgrep -x slurp >/dev/null 2>&1; then
	pkill -x slurp >/dev/null 2>&1 || true
	exit 0
fi

# Neuronix settings / choice popovers are gtk-layer-shell surfaces. Hyprland's
# activewindow Escape never reaches them — close via the singleton lock PID.
_closed=0
for _lock in "${XDG_RUNTIME_DIR}"/neuronix-choice-*.lock; do
	[ -f "$_lock" ] || continue
	_pid="$(tr -cd '0-9' <"$_lock" 2>/dev/null || true)"
	[ -n "$_pid" ] || continue
	kill -0 "$_pid" 2>/dev/null || continue
	# Settings hub: clear any pending section-switch so USR2 always quits.
	case "$_lock" in
	*neuronix-choice-neuronix-settings.lock)
		: >"${XDG_RUNTIME_DIR}/neuronix-settings.request" 2>/dev/null || true
		;;
	esac
	kill -USR2 "$_pid" 2>/dev/null || true
	_closed=1
done
if [ "$_closed" -eq 1 ]; then
	exit 0
fi

if command -v hyprctl >/dev/null 2>&1; then
	hyprctl dispatch sendshortcut ",Escape,activewindow" >/dev/null 2>&1 || true
fi
exit 0
