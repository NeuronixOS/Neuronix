#!/usr/bin/env python3
"""Instant Alt+Tab for Hyprland — Windows-style MRU, no overlay.

Focused monitor, current workspace only.

A complete Alt+Tab (press Tab, release Alt) toggles the last two windows.
Holding Alt and tapping Tab again walks further down recently-used windows.
Shift+Alt+Tab walks the same list backwards.
"""
from __future__ import annotations

import fcntl
import json
import os
import subprocess
import sys
import time

# If Alt-release never arrives, stop treating Tab as "still holding Alt".
STUCK_S = 5.0
STATE_PATH = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", f"/tmp/neuronix-{os.getuid()}"),
    "neuronix-window-switch.json",
)


def _hypr(*args: str) -> str:
    return subprocess.check_output(["hyprctl", *args], text=True)


def _dispatch(*args: str) -> None:
    subprocess.run(
        ["hyprctl", "dispatch", *args],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def _focused_monitor(monitors: list[dict]) -> dict | None:
    for mon in monitors:
        if mon.get("focused"):
            return mon
    return monitors[0] if monitors else None


def _on_monitor(win: dict, mon: dict) -> bool:
    mid = mon.get("id")
    name = mon.get("name")
    wmon = win.get("monitor")
    if wmon == mid or wmon == name:
        return True
    try:
        return int(wmon) == int(mid)
    except (TypeError, ValueError):
        return str(wmon) == str(name)


def _mru_on_focused_desktop() -> tuple[list[str], str | None, str | None]:
    """Addresses on the focused monitor's current workspace, most-recent first."""
    monitors = json.loads(_hypr("monitors", "-j"))
    mon = _focused_monitor(monitors)
    if not mon:
        return [], None, None
    aws = mon.get("activeWorkspace") or {}
    ws_id = aws.get("id")
    ws_name = str(aws.get("name") or "")
    if ws_name.startswith("special"):
        return [], str(mon.get("name") or ""), None

    clients = json.loads(_hypr("clients", "-j"))
    out: list[tuple[int, str]] = []
    for win in clients:
        if not win.get("mapped") or win.get("hidden"):
            continue
        if not _on_monitor(win, mon):
            continue
        ws = win.get("workspace") or {}
        if str(ws.get("name", "")).startswith("special"):
            continue
        if ws_id is not None and ws.get("id") != ws_id:
            continue
        addr = win.get("address")
        if not addr:
            continue
        hist = int(win.get("focusHistoryID", 9999))
        out.append((hist, addr))
    out.sort(key=lambda item: item[0])
    return (
        [addr for _hist, addr in out],
        str(mon.get("name") or ""),
        str(ws_id) if ws_id is not None else ws_name or None,
    )


def _focus(address: str) -> None:
    addr = address if address.startswith("address:") else f"address:{address}"
    _dispatch("focuswindow", addr)
    _dispatch("bringactivetotop")


def _load_state(fh) -> dict:
    try:
        fh.seek(0)
        raw = fh.read()
        return json.loads(raw) if raw else {}
    except (OSError, json.JSONDecodeError):
        return {}


def _save_state(fh, state: dict) -> None:
    fh.seek(0)
    fh.truncate()
    fh.write(json.dumps(state, separators=(",", ":")))
    fh.flush()


def _with_state():
    os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
    return open(STATE_PATH, "a+", encoding="utf-8")


def _commit() -> int:
    """Alt released: next Alt+Tab is a fresh last-two toggle."""
    with _with_state() as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        state = _load_state(fh)
        if not state.get("cycling"):
            return 0
        state["cycling"] = False
        state["t"] = time.monotonic()
        _save_state(fh, state)
    return 0


def _active_address() -> str | None:
    try:
        active = json.loads(_hypr("activewindow", "-j"))
    except Exception:
        return None
    return active.get("address") if isinstance(active, dict) else None


def main(argv: list[str]) -> int:
    if "--commit" in argv:
        return _commit()

    reverse = "--reverse" in argv
    delta = -1 if reverse else 1
    addrs, mon_name, desktop = _mru_on_focused_desktop()
    if len(addrs) < 2:
        return 0

    live = set(addrs)
    now = time.monotonic()
    with _with_state() as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        state = _load_state(fh)
        saved = [a for a in state.get("addrs") or [] if a in live]
        idx = int(state.get("i") or 0)
        cycling = bool(state.get("cycling"))
        same_desktop = (
            state.get("mon") == mon_name and state.get("ws") == desktop
        )
        held = (
            cycling
            and same_desktop
            and len(saved) >= 2
            and (now - float(state.get("t") or 0)) <= STUCK_S
        )
        if held:
            addrs = saved
            idx = (idx + delta) % len(addrs)
        elif addrs[0] == _active_address():
            idx = delta % len(addrs)
        else:
            idx = 0 if not reverse else (len(addrs) - 1)

        target = addrs[idx]
        _save_state(
            fh,
            {
                "t": now,
                "addrs": addrs,
                "i": idx,
                "mon": mon_name,
                "ws": desktop,
                "cycling": True,
            },
        )

    _focus(target)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
