{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "modules-left": [
    "custom/menu",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "custom/gtk-sync",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "battery",
    "clock",
    "tray"
  ],
  "custom/menu": {
    "format": "\uf0c9",
    "tooltip": "Applications",
    "on-click": "fuzzel"
  },
  "custom/gtk-sync": {
    "exec": "gtk-sync-status",
    "return-type": "json",
    "interval": 3,
    "format": "{}",
    "tooltip": true,
    "on-click": "gtk-sync-menu",
    "on-click-right": "gtk-sync-status"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 60
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "\uf026",
    "format-icons": [
      "\uf026",
      "\uf027",
      "\uf028"
    ],
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "\uf1eb {signalStrength}%",
    "format-ethernet": "\uf1e6",
    "format-disconnected": "\uf071",
    "on-click": "nm-connection-editor"
  },
  "cpu": {
    "interval": 2,
    "format": "\uf2db {usage}%",
    "tooltip": true,
    "on-click": "foot -T btop -a org.neuronix.btop btop"
  },
  "memory": {
    "interval": 2,
    "format": "\uf1c0 {percentage}%",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB",
    "on-click": "foot -T btop -a org.neuronix.btop btop"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "{capacity}% \uf0e7",
    "format-plugged": "{capacity}% \uf1e6",
    "format-icons": [
      "\uf244",
      "\uf243",
      "\uf242",
      "\uf241",
      "\uf240"
    ],
    "on-click": "neuronix-power-settings"
  },
  "clock": {
    "interval": 30,
    "format": "{:%a %b %d  %I:%M %p}",
    "tooltip-format": "<big>{:%A, %B %d %Y}</big>\n\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "days": "{}",
        "weeks": "<span color='#888888'><b>W{}</b></span>",
        "weekdays": "<b>{}</b>",
        "today": "<span color='#e02020'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    },
    "on-click": "neuronix-datetime calendar",
    "on-click-right": "neuronix-datetime"
  },
  "tray": {
    "spacing": 8
  }
}
