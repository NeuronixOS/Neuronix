[Desktop Entry]
Version=1.0
Type=Application
Name=Calendar
Comment=GTK4 calendar (Google and .ics)
Exec=gtk-calendar %U
TryExec=gtk-calendar
Icon=x-office-calendar
Terminal=false
Categories=Office;Calendar;Utility;
MimeType=text/calendar;application/ics;x-scheme-handler/webcal;
StartupNotify=true
StartupWMClass=org.neuronix.GtkCalendar
