[Desktop Entry]
Version=1.0
Type=Application
Name=Text Editor
Comment=Neuronix GTK4 text editor (gtk-edit)
Exec=gtk-edit %F
TryExec=gtk-edit
Icon=accessories-text-editor
Terminal=false
MimeType=text/plain;text/markdown;text/x-markdown;text/css;text/html;text/xml;text/x-csrc;text/x-c++src;text/x-python;text/x-shellscript;text/x-makefile;text/x-java;text/x-rust;text/javascript;application/javascript;application/json;application/xml;application/x-desktop;application/x-zerosize;inode/x-empty;text/x-log;text/x-patch;text/x-diff;
Categories=Utility;TextEditor;
StartupNotify=true
StartupWMClass=org.neuronix.GtkEdit
