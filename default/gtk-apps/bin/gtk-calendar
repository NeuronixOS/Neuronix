#!/usr/bin/env bash
set -euo pipefail
# Resolve through /usr/local/bin → ../lib/neuronix/gtk-apps symlink
SCRIPT="$(readlink -f "$0")"
LIB="$(cd "$(dirname "$SCRIPT")" && pwd)"
APP="$LIB/apps/gtk-calendar"
THEME=""
for cand in "$LIB/python" "$LIB/gtk-theme/python" /usr/share/neuronix/gtk-theme/python; do
  [[ -f "$cand/gtk_theme.py" ]] && THEME="$cand" && break
done
export PYTHONPATH="${THEME:+$THEME:}$APP${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1
cd "$APP"
exec python3 "$APP/app.py" "$@"
