#!/usr/bin/env bash
set -euo pipefail
# Resolve through /usr/local/bin → ../lib/neuronix/gtk-apps symlink
SCRIPT="$(readlink -f "$0")"
LIB="$(cd "$(dirname "$SCRIPT")" && pwd)"
APP="$LIB/apps/gtk-configs"
THEME=""
for cand in "$LIB/gtk-theme/python" /usr/share/neuronix/gtk-theme/python; do
  [[ -f "$cand/gtk_theme.py" ]] && THEME="$cand" && break
done
export PYTHONPATH="${THEME:+$THEME:}${PYTHONPATH:-}"
exec python3 "$APP/configs.py" "$@"
