# Neuronix Debian (trixie) profile — sourced by neuronix-iso/setup.sh and build.sh

NEURONIX_PROFILE_ID=debian
NEURONIX_DISTRO=debian
NEURONIX_SUITE=trixie
NEURONIX_PRODUCT_NAME=Neuronix
NEURONIX_PRODUCT_VERSION=0.1
NEURONIX_LIVE_HOSTNAME=neuronix-hyprland

NEURONIX_BUILD_ROOT_VAR=NEURONIX_BUILD_ROOT
NEURONIX_BUILD_ROOT_DEFAULT="${HOME}/neuronix-build-iso"

LB_MODE=
LB_DISTRIBUTION=trixie
LB_PARENT_DISTRIBUTION=
LB_ARCHIVE_AREAS="main contrib non-free non-free-firmware"
LB_MIRROR=
LB_LINUX_FLAVOURS=
LB_INITRAMFS=
LB_LIVE_USER_PASSWORD=live
LB_FORCE_LIVE_LIST=0
LB_UBUNTU_KEYRING_CHECK=0

NEURONIX_DESKTOP_SESSION=neuronix-hyprland
NEURONIX_CALAMARES_INSTALLER=calamares-install-debian
NEURONIX_WELCOME_URLS=debian.org,deb.debian.org
NEURONIX_ENABLE_BACKPORTS=1
NEURONIX_FLATPAK_DECIBELS=0

NEURONIX_DISTRO_CONF=debian.distro.conf
NEURONIX_GRUB_FALLBACK_MSG="Debian testing GRUB art"
