#!/bin/bash
# Enable cron and install Neuronix crontab for the live user (skel default user).
set -e
if systemctl enable cron.service 2>/dev/null || systemctl enable cron 2>/dev/null; then
	:
fi
if [[ -x /usr/local/sbin/neuronix-install-crontab.sh ]]; then
	/usr/local/sbin/neuronix-install-crontab.sh || true
fi
