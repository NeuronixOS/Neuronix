#!/usr/bin/env python3
"""Neuronix calendar popover — layer-shell so hyprbars never paints a title bar."""
from __future__ import annotations

import datetime as _dt
import os
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, Gdk, GtkLayerShell  # noqa: E402


def _notify(text: str) -> None:
    try:
        gi.require_version("Notify", "0.7")
        from gi.repository import Notify

        if not Notify.is_initted():
            Notify.init("Neuronix")
        n = Notify.Notification.new("Calendar", text, None)
        n.set_timeout(4000)
        n.show()
    except Exception:
        pass


def main() -> int:
    today = _dt.date.today()
    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_title("Calendar")
    win.set_resizable(False)
    win.set_decorated(False)
    win.set_default_size(440, 360)

    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.TOP)
    GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.TOP, True)
    GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.RIGHT, True)
    GtkLayerShell.set_margin(win, GtkLayerShell.Edge.TOP, 40)
    GtkLayerShell.set_margin(win, GtkLayerShell.Edge.RIGHT, 12)
    GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.ON_DEMAND)

    css = Gtk.CssProvider()
    css.load_from_data(
        b"""
        window {
          background-color: #2e2e2e;
          border: 1px solid #505050;
          border-radius: 10px;
          color: #f5f5f5;
        }
        label.today-label {
          color: #f5f5f5;
          font-size: 16px;
          font-weight: 600;
          padding: 2px 0 6px 0;
        }
        calendar {
          background-color: #2e2e2e;
          color: #f5f5f5;
          font-size: 16px;
          min-width: 400px;
        }
        /* Solid Neuronix red chip on the selected / current day only */
        calendar:selected {
          background-color: #e02020;
          color: #ffffff;
          border-radius: 999px;
          font-weight: bold;
        }
        button {
          background-color: #3a3a3a;
          color: #f5f5f5;
          border: none;
          border-radius: 8px;
          padding: 10px 22px;
          margin: 2px;
          font-size: 14px;
          min-width: 96px;
        }
        button:hover { background-color: #4a4a4a; }
        """
    )
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    box.set_margin_top(16)
    box.set_margin_bottom(16)
    box.set_margin_start(16)
    box.set_margin_end(16)
    win.add(box)

    label = Gtk.Label(label=today.strftime("Today is %A, %B %d %Y"))
    label.get_style_context().add_class("today-label")
    label.set_xalign(0.0)
    box.pack_start(label, False, False, 0)

    cal = Gtk.Calendar()
    cal.set_display_options(
        Gtk.CalendarDisplayOptions.SHOW_HEADING
        | Gtk.CalendarDisplayOptions.SHOW_DAY_NAMES
    )

    def _mark_today(*_a):
        cal.clear_marks()
        y, m, _d = cal.get_date()
        if int(y) == today.year and int(m) + 1 == today.month:
            cal.mark_day(today.day)
            cal.select_day(today.day)

    cal.select_month(today.month - 1, today.year)
    cal.select_day(today.day)
    cal.mark_day(today.day)
    cal.connect("month-changed", _mark_today)
    box.pack_start(cal, True, True, 0)

    buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    buttons.set_halign(Gtk.Align.END)
    cancel = Gtk.Button(label="Cancel")
    ok = Gtk.Button(label="OK")
    buttons.pack_start(cancel, False, False, 0)
    buttons.pack_start(ok, False, False, 0)
    box.pack_start(buttons, False, False, 0)

    def _close(*_a):
        Gtk.main_quit()
        return False

    def _ok(*_a):
        y, m, d = cal.get_date()
        picked = _dt.date(int(y), int(m) + 1, int(d))
        _notify(f"Selected: {picked.isoformat()}")
        _close()

    cancel.connect("clicked", _close)
    ok.connect("clicked", _ok)
    win.connect("key-press-event", lambda _w, e: _close() if e.keyval == Gdk.KEY_Escape else False)
    win.connect("destroy", _close)

    win.show_all()
    win.present()
    Gtk.main()
    return 0


if __name__ == "__main__":
    os.environ.setdefault("XDG_CURRENT_DESKTOP", "Hyprland")
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"neuronix-calendar: {exc}", file=sys.stderr)
        os.execvp(
            "zenity",
            [
                "zenity",
                "--calendar",
                "--title=Calendar",
                f"--text=Today is {_dt.date.today():%A, %B %d %Y}",
            ],
        )
