#!/usr/bin/env python3
"""Date and time menu. Calendar, clock format, and time zone open on the right."""
from __future__ import annotations

import datetime as dt
import json
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, Pango  # noqa: E402

sys.path.insert(0, "/usr/share/neuronix")
sys.path.insert(0, os.path.expanduser("~/.local/share/neuronix"))
from neuronix_choice_dialog import DrillItem, MonthCalendar, show_drilldown  # noqa: E402

PREF = os.path.expanduser("~/.config/neuronix/clock-format")
WAYBAR = os.path.expanduser("~/.config/waybar/config")
FMT_12 = "{:%I:%M %p  %b %d}"
FMT_24 = "{:%H:%M  %b %d}"


def _sibling_script(name: str) -> str:
    me = os.path.realpath(__file__)
    here = os.path.dirname(me)
    for path in (
        os.path.join(os.path.expanduser("~/.local/bin"), name),
        os.path.join(here, name),
        os.path.join("/usr/local/bin", name),
    ):
        if os.path.isfile(path) and os.path.realpath(path) != me:
            return path
    return ""


def _notify(summary: str, body: str) -> None:
    subprocess.Popen(
        ["notify-send", "-a", "Neuronix", "-t", "4000", summary, body],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def _close() -> None:
    GLib.idle_add(Gtk.main_quit)


def _current_fmt() -> str:
    try:
        mode = open(PREF, encoding="utf-8").read().strip()
    except Exception:
        return "12"
    return "24" if mode == "24" else "12"


def _clock_now() -> str:
    return dt.datetime.now().strftime("%A, %B %d %Y  %I:%M %p")


def _timezone_now() -> str:
    try:
        return subprocess.check_output(
            ["timedatectl", "show", "-p", "Timezone", "--value"],
            text=True,
            timeout=3,
        ).strip() or "UTC"
    except Exception:
        return "UTC"


def _apply_waybar_format(mode: str) -> bool:
    os.makedirs(os.path.dirname(PREF), exist_ok=True)
    with open(PREF, "w", encoding="utf-8") as handle:
        handle.write(mode + "\n")
    fmt = FMT_24 if mode == "24" else FMT_12
    try:
        with open(WAYBAR, encoding="utf-8") as handle:
            cfg = json.load(handle)
        clock = cfg.setdefault("clock", {})
        clock["format"] = fmt
        with open(WAYBAR, "w", encoding="utf-8") as handle:
            json.dump(cfg, handle, indent=2)
            handle.write("\n")
    except Exception:
        return False
    subprocess.run(["pkill", "-USR2", "-x", "waybar"], check=False)
    return True


def _toggle_clock(item_id: str) -> None:
    mode = "12" if item_id == "fmt12" else "24"
    if _apply_waybar_format(mode):
        _notify("Clock", "Using a 12-hour clock." if mode == "12" else "Using a 24-hour clock.")
    else:
        _notify("Clock", "Saved the preference, but the bar format could not be updated.")
    _close()


def _calendar_page() -> Gtk.Widget:
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    today = dt.date.today()
    cal = MonthCalendar()
    picked = Gtk.Label(label=today.isoformat(), xalign=0.0)
    picked.get_style_context().add_class("neuronix-subtitle")

    def _on_day(*_a) -> None:
        year, month, day = cal.get_date()
        picked.set_text(f"{int(year):04d}-{int(month) + 1:02d}-{int(day):02d}")

    cal.connect("day-selected", _on_day)
    box.pack_start(cal, True, True, 0)
    box.pack_start(picked, False, False, 0)
    return box


def _set_clock_page() -> Gtk.Widget:
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    cal = MonthCalendar()
    entry = Gtk.Entry()
    entry.get_style_context().add_class("neuronix-entry")
    entry.set_text(dt.datetime.now().strftime("%H:%M"))
    hint = Gtk.Label(label="Time as HH:MM, 24-hour", xalign=0.0)
    hint.get_style_context().add_class("neuronix-subtitle")
    note = Gtk.Label(label="", xalign=0.0)
    note.set_line_wrap(True)
    note.get_style_context().add_class("neuronix-body")
    apply_btn = Gtk.Button(label="Set clock")
    apply_btn.get_style_context().add_class("neuronix-primary")

    def _apply(*_a) -> None:
        year, month, day = cal.get_date()
        date = f"{int(year):04d}-{int(month) + 1:02d}-{int(day):02d}"
        clock = (entry.get_text() or "").strip()
        try:
            parsed = dt.datetime.strptime(f"{date} {clock}", "%Y-%m-%d %H:%M")
        except Exception:
            note.set_text(f"Could not parse {date} {clock}")
            return
        iso = parsed.strftime("%Y-%m-%d %H:%M:%S")
        result = subprocess.run(
            ["pkexec", "timedatectl", "set-time", iso],
            check=False,
        )
        if result.returncode == 0:
            note.set_text(f"Set to {iso}")
            _notify("Date & time", f"Set to {iso}")
        else:
            note.set_text("Failed to set the clock. Admin rights are required.")

    apply_btn.connect("clicked", _apply)
    box.pack_start(cal, True, True, 0)
    box.pack_start(hint, False, False, 0)
    box.pack_start(entry, False, False, 0)
    box.pack_start(apply_btn, False, False, 0)
    box.pack_start(note, False, False, 0)
    return box


def _timezone_page() -> Gtk.Widget:
    current = _timezone_now()
    try:
        zones = [
            line.strip()
            for line in subprocess.check_output(
                ["timedatectl", "list-timezones"], text=True, timeout=8
            ).splitlines()
            if line.strip()
        ]
    except Exception:
        zones = [current]
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    search = Gtk.SearchEntry()
    search.set_placeholder_text("Search cities or regions…")
    note = Gtk.Label(label=f"Current: {current}", xalign=0.0)
    note.set_line_wrap(True)
    note.get_style_context().add_class("neuronix-subtitle")
    listbox = Gtk.ListBox()
    listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
    listbox.get_style_context().add_class("neuronix-list")
    for zone in zones:
        row = Gtk.ListBoxRow()
        row.get_style_context().add_class("neuronix-list-row")
        city, _, region = zone.partition("/")
        label = zone.split("/")[-1].replace("_", " ")
        region_txt = zone if zone == label else zone
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        title = Gtk.Label(label=label, xalign=0.0)
        title.get_style_context().add_class("neuronix-row-title")
        title.set_ellipsize(Pango.EllipsizeMode.END)
        desc = Gtk.Label(
            label=(region_txt + "  ·  current") if zone == current else region_txt,
            xalign=0.0,
        )
        desc.get_style_context().add_class("neuronix-row-desc")
        desc.set_ellipsize(Pango.EllipsizeMode.END)
        inner.pack_start(title, False, False, 0)
        inner.pack_start(desc, False, False, 0)
        row.add(inner)
        row._zone = zone  # type: ignore[attr-defined]
        row._hay = zone.lower()  # type: ignore[attr-defined]
        if zone == current:
            row.get_style_context().add_class("current")
        listbox.add(row)
        _ = city

    def _filter(row: Gtk.ListBoxRow) -> bool:
        query = (search.get_text() or "").strip().lower()
        if not query:
            return True
        return query in str(getattr(row, "_hay", ""))

    listbox.set_filter_func(_filter)
    search.connect("search-changed", lambda *_: listbox.invalidate_filter())

    def _pick(_lb, row: Gtk.ListBoxRow) -> None:
        zone = str(getattr(row, "_zone", "") or "")
        if not zone:
            return
        result = subprocess.run(
            ["pkexec", "timedatectl", "set-timezone", zone],
            check=False,
        )
        if result.returncode == 0:
            note.set_text(f"Current: {zone}")
            _notify("Time zone", f"Set to {zone}")
        else:
            note.set_text("Failed to set the time zone. Admin rights are required.")

    listbox.connect("row-activated", _pick)
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    scroll.get_style_context().add_class("neuronix-list-frame")
    scroll.set_size_request(380, 280)
    scroll.set_vexpand(True)
    scroll.add(listbox)
    box.pack_start(note, False, False, 0)
    box.pack_start(search, False, False, 0)
    box.pack_start(scroll, True, True, 0)
    return box


def datetime_items() -> tuple:
    cur = _current_fmt()
    if cur == "24":
        toggle = DrillItem(
            "fmt12",
            "Use 12-hour clock",
            "Switch the bar clock to AM/PM",
            action=_toggle_clock,
        )
    else:
        toggle = DrillItem(
            "fmt24",
            "Use 24-hour clock",
            "Switch the bar clock to 24-hour time",
            action=_toggle_clock,
        )
    subtitle = f"{_clock_now()}\nTimezone: {_timezone_now()}"
    items = [
        DrillItem("calendar", "Calendar", "Pick a date on the calendar", panel=_calendar_page),
        toggle,
        DrillItem(
            "setclock",
            "Set date & time",
            "Change the system clock (admin)",
            panel=_set_clock_page,
        ),
        DrillItem(
            "timezone",
            "Time zone",
            "Change the system time zone (admin)",
            panel=_timezone_page,
        ),
    ]
    return subtitle, items


def main() -> int:
    os.environ.setdefault("XDG_CURRENT_DESKTOP", "Hyprland")
    mode = (sys.argv[1] if len(sys.argv) > 1 else "menu").strip().lower()
    if mode not in ("menu", "calendar", ""):
        print("Usage: neuronix-datetime [calendar|menu]", file=sys.stderr)
        return 2
    hub = _sibling_script("neuronix-settings")
    if hub:
        args = [hub, "datetime"]
        if mode == "calendar":
            args.append("calendar")
        os.execv(hub, args)
    subtitle, items = datetime_items()
    show_drilldown(
        "Date & Time",
        items,
        subtitle=subtitle,
        initial="calendar" if mode == "calendar" else None,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
