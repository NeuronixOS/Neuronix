#!/bin/sh
# Ensure hyprbars (titlebar × □) is always loaded for this Hyprland session.
# Prefer the ISO-built / packaged plugin (.so); fall back to hyprpm when ABI matches.
# Image borders, if present, load first: plugin load after hyprbars reloads config
# and hyprbars-button can segfault Hyprland 0.55.2.
#
# Themes → Window chrome prefs: ~/.config/hypr/neuronix-window-chrome.json
#   {"hyprbars": true, "hyprbars_images": true, "hyprframes": true, "hyprtabs": false}
# hyprbars is always on; hyprbars_images toggles plugin:hyprbars:bar_image.
set -eu

MARKER="${HOME}/.config/hypr/.neuronix-hyprbars-ok"
PREFS="${HOME}/.config/hypr/neuronix-window-chrome.json"
PLUGIN_DIR="/usr/lib/x86_64-linux-gnu/hyprland/plugins"
DEFAULT_BAR_IMAGE="${HOME}/.local/share/neuronix/hyprbars/tile-grey-round.png"
mkdir -p "${HOME}/.config/hypr"

command -v hyprctl >/dev/null 2>&1 || exit 0

_pref_on() {
	# $1 = hyprbars|hyprbars_images|hyprframes|hyprtabs
	# hyprbars always on; hyprframes/images default true; hyprtabs defaults false.
	key="$1"
	if [ "$key" = "hyprbars" ]; then
		return 0
	fi
	if [ ! -f "${PREFS}" ]; then
		[ "$key" = "hyprtabs" ] && return 1
		return 0
	fi
	python3 - "$PREFS" "$key" <<'PY'
import json, sys
path, key = sys.argv[1], sys.argv[2]
default_on = key != "hyprtabs"
try:
    data = json.loads(open(path, encoding="utf-8").read())
except Exception:
    sys.exit(0 if default_on else 1)
if not isinstance(data, dict):
    sys.exit(0 if default_on else 1)
# Migrate: old hyprbars=false → images off.
if key == "hyprbars_images" and "hyprbars_images" not in data and "hyprbars" in data:
    sys.exit(0 if data.get("hyprbars") else 1)
if key not in data:
    sys.exit(0 if default_on else 1)
sys.exit(0 if data.get(key) else 1)
PY
}

_plugin_loaded() {
	hyprctl plugin list 2>/dev/null | grep -qi "$1"
}

_unload_hyprframes() {
	_plugin_loaded hyprframes || return 0
	for PLUGIN_SO in \
		"${HOME}/.local/lib/hyprland/plugins/libhyprframes.so" \
		"/usr/local/lib/hyprland/plugins/libhyprframes.so" \
		"${PLUGIN_DIR}/libhyprframes.so"; do
		[ -f "${PLUGIN_SO}" ] || continue
		hyprctl plugin unload "${PLUGIN_SO}" >/dev/null 2>&1 || true
		_plugin_loaded hyprframes || return 0
	done
}

_load_hyprframes() {
	_plugin_loaded hyprframes && return 0
	for PLUGIN_SO in \
		"${HOME}/.local/lib/hyprland/plugins/libhyprframes.so" \
		"/usr/local/lib/hyprland/plugins/libhyprframes.so" \
		"${PLUGIN_DIR}/libhyprframes.so"; do
		[ -f "${PLUGIN_SO}" ] || continue
		hyprctl plugin load "${PLUGIN_SO}" >/dev/null 2>&1 || true
		_plugin_loaded hyprframes && return 0
	done
	return 0
}

_set_hyprbars_enabled() {
	_plugin_loaded hyprbars || return 0
	hyprctl keyword plugin:hyprbars:enabled true >/dev/null 2>&1 || true
}

_apply_hyprbars_images() {
	_plugin_loaded hyprbars || return 0
	if _pref_on hyprbars_images; then
		img="${DEFAULT_BAR_IMAGE}"
		for cand in \
			"${DEFAULT_BAR_IMAGE}" \
			"/usr/share/neuronix/hyprbars/tile-grey-round.png" \
			"/usr/local/share/neuronix/hyprbars/tile-grey-round.png"; do
			[ -f "${cand}" ] || continue
			img="${cand}"
			break
		done
		hyprctl keyword plugin:hyprbars:bar_image "${img}" >/dev/null 2>&1 || true
	else
		hyprctl keyword plugin:hyprbars:bar_image "" >/dev/null 2>&1 || true
	fi
}

_set_hyprtabs_enabled() {
	# $1 = true|false
	_plugin_loaded hyprtabs || return 0
	hyprctl keyword plugin:hyprtabs:enabled "$1" >/dev/null 2>&1 || true
}

_load_hyprtabs() {
	_plugin_loaded hyprtabs && return 0
	for PLUGIN_SO in \
		"${HOME}/.local/lib/hyprland/plugins/libhyprtabs.so" \
		"/usr/local/lib/hyprland/plugins/libhyprtabs.so" \
		"${PLUGIN_DIR}/libhyprtabs.so"; do
		[ -f "${PLUGIN_SO}" ] || continue
		hyprctl plugin load "${PLUGIN_SO}" >/dev/null 2>&1 || true
		_plugin_loaded hyprtabs && return 0
	done
	return 0
}

_ensure_hyprtabs() {
	if _pref_on hyprtabs; then
		_load_hyprtabs
		_set_hyprtabs_enabled true
	elif _plugin_loaded hyprtabs; then
		_set_hyprtabs_enabled false
	fi
}

_loaded() {
	_plugin_loaded hyprbars
}

# Apply Themes prefs (hyprframes may already be loaded via `plugin =` in conf).
if _pref_on hyprframes; then
	_load_hyprframes
else
	_unload_hyprframes
fi

# Hyprbars is always on.
if _loaded; then
	_set_hyprbars_enabled
	_apply_hyprbars_images
	touch "${MARKER}"
	_ensure_hyprtabs
	exit 0
fi

for PLUGIN_SO in \
	"${HOME}/.local/lib/hyprland/plugins/libhyprbars.so" \
	"/usr/local/lib/hyprland/plugins/libhyprbars.so" \
	"${PLUGIN_DIR}/libhyprbars.so" \
	"${PLUGIN_DIR}/hyprbars.so"; do
	[ -f "${PLUGIN_SO}" ] || continue
	hyprctl plugin load "${PLUGIN_SO}" >/dev/null 2>&1 || true
	if _loaded; then
		_set_hyprbars_enabled
		_apply_hyprbars_images
		touch "${MARKER}"
		_ensure_hyprtabs
		exit 0
	fi
done

command -v hyprpm >/dev/null 2>&1 || {
	_ensure_hyprtabs
	exit 0
}

if hyprpm list 2>/dev/null | grep -A1 'Plugin hyprbars' | grep -q 'enabled:.*true'; then
	hyprpm reload -n 2>/dev/null || true
	if _loaded; then
		_set_hyprbars_enabled
		_apply_hyprbars_images
		touch "${MARKER}"
		_ensure_hyprtabs
		exit 0
	fi
fi

if [ -f "${MARKER}" ]; then
	hyprpm reload -n 2>/dev/null || true
	_ensure_hyprtabs
	exit 0
fi

if ! command -v cmake >/dev/null 2>&1 || ! command -v g++ >/dev/null 2>&1; then
	_ensure_hyprtabs
	exit 0
fi

hyprpm update >/dev/null 2>&1 || true
if ! hyprpm list 2>/dev/null | grep -q 'Repository hyprland-plugins'; then
	yes Y | hyprpm add https://github.com/hyprwm/hyprland-plugins >/dev/null 2>&1 || true
fi
hyprpm enable hyprbars >/dev/null 2>&1 || true
hyprpm reload -n 2>/dev/null || true
if _loaded; then
	_set_hyprbars_enabled
	_apply_hyprbars_images
	touch "${MARKER}"
fi
_ensure_hyprtabs
exit 0
