#!/bin/sh
# Fuzzel with Neuronix session env so menu-launched apps inherit GSK_RENDERER etc.
#
# Full-width bottom launcher: modest side pads so the search box and match list
# sit on the left (fuzzel left-aligns text within the content column).
# Border comes from fuzzel.ini.
# Font size must stay in sync with configs/fuzzel/fuzzel.ini (Sans:size=24).
set -eu

export PATH="${HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

# Prefer an explicit --output= from the caller (e.g. Super overview → HDMI).
_cli_out=""
for _arg in "$@"; do
	case "${_arg}" in
		--output=*) _cli_out="${_arg#--output=}" ;;
	esac
done

FUZZEL_ARGS=""
if command -v hyprctl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
	FUZZEL_ARGS="$(
		OUT="${_cli_out}" hyprctl monitors -j 2>/dev/null | python3 -c '
import json, os, sys
try:
    monitors = json.load(sys.stdin)
except Exception:
    sys.exit(0)
want = (os.environ.get("OUT") or "").strip()
focused = next((m for m in monitors if want and m.get("name") == want), None)
if focused is None:
    focused = next((m for m in monitors if m.get("focused")), None)
if focused is None and monitors:
    focused = monitors[0]
if not focused:
    sys.exit(0)
name = focused.get("name") or ""
w = int(focused.get("width") or 0)
h = int(focused.get("height") or 0)
if not name or w <= 0:
    sys.exit(0)
tr = int(focused.get("transform") or 0)
if tr in (1, 3, 5, 7):
    w, h = h, w
scale = float(focused.get("scale") or 1) or 1.0
logical_w = w / scale
# Sans:size=24 ≈ 32px advance; match fuzzel.ini [border] width=10.
char_px = 32.0
border_px = 10.0
hpad = 28
inner = max(char_px * 16, logical_w - 2.0 * border_px - 2.0 * hpad)
chars = max(16, int(inner / char_px))
print(f"--output={name} --width={chars} --horizontal-pad={hpad}")
' 2>/dev/null || true
	)"
fi

# Drop any leftover chrome panel from the previous layout.
pkill -f neuronix_fuzzel_panel.py >/dev/null 2>&1 || true

# shellcheck disable=SC2086
exec /usr/local/bin/neuronix-launch fuzzel ${FUZZEL_ARGS} --layer=overlay "$@"
