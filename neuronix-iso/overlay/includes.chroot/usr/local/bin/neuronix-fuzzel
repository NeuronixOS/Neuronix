#!/bin/sh
# Fuzzel with Neuronix session env so menu-launched apps inherit GSK_RENDERER etc.
# Full-bleed bottom bar on the focused monitor: character width is the *content*
# column; horizontal-pad fills the sides so the prompt + matches sit centered
# (fuzzel cannot center-align text itself).
# Font size must stay in sync with configs/fuzzel/fuzzel.ini (Sans:size=24).
set -eu

FUZZEL_ARGS=""
if command -v hyprctl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
	FUZZEL_ARGS="$(
		hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
try:
    monitors = json.load(sys.stdin)
except Exception:
    sys.exit(0)
focused = next((m for m in monitors if m.get("focused")), None)
if focused is None and monitors:
    focused = monitors[0]
if not focused:
    sys.exit(0)
name = focused.get("name") or ""
w = int(focused.get("width") or 0)
h = int(focused.get("height") or 0)
if not name or w <= 0:
    sys.exit(0)
# Portrait transforms report panel WxH; layout span swaps.
tr = int(focused.get("transform") or 0)
if tr in (1, 3, 5, 7):
    w, h = h, w
scale = float(focused.get("scale") or 1) or 1.0
logical_w = w / scale
# Sans:size=24 ≈ 32px advance (measured)
char_px = 32.0
# Centered content column for large type (~20–24 glyphs + icon)
content_px = min(800.0, max(480.0, logical_w * 0.28))
chars = max(16, int(content_px / char_px))
# horizontal-pad is *added* around the character grid → full-bleed bar
hpad = max(24, int((logical_w - chars * char_px) / 2))
print(f"--output={name} --width={chars} --horizontal-pad={hpad}")
' 2>/dev/null || true
	)"
fi

# shellcheck disable=SC2086
exec /usr/local/bin/neuronix-launch fuzzel $FUZZEL_ARGS "$@"
