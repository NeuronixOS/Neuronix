#!/usr/bin/env python3
"""Waybar settings window. Every Settings page opens here."""
from __future__ import annotations

import os
import sys

os.environ.setdefault("XDG_CURRENT_DESKTOP", "Hyprland")

share = os.path.expanduser("~/.local/share/neuronix")
here = os.path.dirname(os.path.realpath(__file__))
# Installed Neuronix modules win. A checkout next to this script still works.
sys.path.insert(0, share)
sys.path.insert(0, here)
sys.path.insert(0, "/usr/share/neuronix")

from neuronix_choice_dialog import HubSection, show_hub  # noqa: E402
import neuronix_quick_settings as quick  # noqa: E402
import neuronix_settings_pages as pages  # noqa: E402


def _load(path: str, name: str) -> dict:
    ns: dict = {"__name__": name, "__file__": path, "__package__": None}
    with open(path, encoding="utf-8") as handle:
        exec(compile(handle.read(), path, "exec"), ns)
    return ns


def _sibling_script(name: str) -> str:
    """User copy, this file's directory, then the system bin."""
    me = os.path.realpath(__file__)
    for path in (
        os.path.join(os.path.expanduser("~/.local/bin"), name),
        os.path.join(here, name),
        os.path.join("/usr/local/bin", name),
    ):
        if os.path.isfile(path) and os.path.realpath(path) != me:
            return path
    return ""


def _plain(items):
    return "", items, None


def main() -> int:
    sync_path = _sibling_script("gtk-sync-menu")
    clock_path = _sibling_script("neuronix-datetime")
    missing = [
        name
        for name, path in (
            ("gtk-sync-menu", sync_path),
            ("neuronix-datetime", clock_path),
        )
        if not path
    ]
    if missing:
        print("neuronix-settings: missing " + ", ".join(missing), file=sys.stderr)
        return 1
    sync = _load(sync_path, "gtk_sync_menu")
    clock = _load(clock_path, "neuronix_datetime")

    def _sync():
        return "Choose an action.", sync["sync_items"](), None

    def _clock():
        subtitle, items = clock["datetime_items"]()
        return subtitle, items, "calendar"

    sections = [
        HubSection("wifi", "Wi-Fi", "network-wireless", page=pages.wifi_page),
        HubSection("ethernet", "Ethernet", "network-wired", page=pages.ethernet_page),
        HubSection("bluetooth", "Bluetooth", "bluetooth", page=pages.bluetooth_page),
        HubSection("displays", "Displays", "video-display", page=pages.displays_page),
        HubSection("sound", "Sound", "audio-volume-high", page=pages.sound_page),
        HubSection("apps", "Apps", "preferences-desktop-default-applications", page=pages.apps_page),
        HubSection("themes", "Themes", "preferences-desktop-theme", page=pages.themes_page),
        HubSection("updates", "Updates", "system-software-update", page=pages.updates_page),
        HubSection("configs", "Configs", "folder", page=pages.configs_page),
        HubSection("screensaver", "Screensaver", "preferences-desktop-screensaver", page=pages.screensaver_page),
        HubSection("system", "System", "preferences-system", page=pages.system_page),
        HubSection("sync", "GTK-Sync", "emblem-synchronizing", _sync),
        HubSection("datetime", "Date & Time", "x-office-calendar", _clock),
        HubSection("keyboard", "Keyboard", "input-keyboard", page=pages.keyboard_page),
        HubSection("about", "About", "help-about", page=pages.about_page),
        HubSection("power", "Power", "system-shutdown", lambda: _plain(quick.power_items())),
    ]
    section = (sys.argv[1] if len(sys.argv) > 1 else "wifi").strip().lower()
    drill = (sys.argv[2] if len(sys.argv) > 2 else "").strip().lower()
    aliases = {
        "volume": "sound",
        "audio": "sound",
        "pulse": "sound",
        "network": "wifi",
        "nm": "wifi",
        "cpu": "system",
        "battery": "system",
        "memory": "system",
        "ram": "system",
        "mem": "system",
        "session": "power",
        "calendar": "datetime",
        "clock": "datetime",
        "gtk-sync": "sync",
        "gtksync": "sync",
        "theme": "themes",
        "update": "updates",
        "updater": "updates",
        "software": "updates",
        "apt": "updates",
        "appearance": "themes",
        "config": "configs",
        "idle": "screensaver",
        "date-time": "datetime",
    }
    section = aliases.get(section, section)
    show_hub(sections, section, drill)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
