#!/bin/sh
# Neuronix settings hub — modular Hyprland settings (no gnome-control-center).
set -eu

# Freeze the bar click before PATH/GTK work (Active-User jiggles the pointer).
if [ -z "${NEURONIX_CLICK_XY:-}" ]; then
	NEURONIX_CLICK_XY="$(/usr/bin/hyprctl cursorpos 2>/dev/null | tr -d ' ' || true)"
	export NEURONIX_CLICK_XY
fi

export PATH="${HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games${PATH:+:$PATH}"
_uid="$(id -u)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${_uid}}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

if [ -r /usr/share/neuronix/neuronix-hyprland-session-env.sh ]; then
	# shellcheck disable=SC1091
	. /usr/share/neuronix/neuronix-hyprland-session-env.sh
	neuronix_hyprland_session_env
fi
export PATH="${HOME}/.local/bin:${PATH}"

_pick="$(
	python3 - <<'PY'
import os, sys
sys.path.insert(0, "/usr/share/neuronix")
sys.path.insert(0, os.path.expanduser("~/.local/share/neuronix"))
from neuronix_choice_dialog import choose

items = [
    ("display", "Display", "Resolution, layout, and monitors"),
    ("network", "Network", "Wi-Fi, VPN, and connections"),
    ("sound", "Sound", "Speakers, microphones, and volume"),
    ("bluetooth", "Bluetooth", "Pair and manage devices"),
    ("appearance", "Appearance", "GTK theme and icons"),
    ("background", "Background", "Desktop wallpaper"),
    ("datetime", "Date & Time", "Clock format, calendar, timezone"),
    ("keyboard", "Keyboard", "Edit Hyprland keyboard layout"),
    ("power", "Power", "Sleep, battery, and power"),
    ("printers", "Printers", "Add and manage printers"),
    ("disks", "Disks", "Partition and format drives"),
    ("advanced", "Advanced", "dconf-editor (GTK keys)"),
]
pick = choose(
    "Neuronix Settings",
    "Choose a category — each opens its own settings app.",
    items,
    width=540,
    height=700,
)
if pick:
    print(pick)
PY
)" || true

[ -n "${_pick:-}" ] || exit 0

case "${_pick}" in
	display)     exec nwg-displays ;;
	network)     exec nm-connection-editor ;;
	sound)       exec pavucontrol ;;
	bluetooth)   exec blueman-manager ;;
	appearance)  exec nwg-look ;;
	background)  exec neuronix-change-background ;;
	datetime)    exec neuronix-datetime ;;
	keyboard)    exec gtk-edit "${HOME}/.config/hypr/hyprland.conf" ;;
	power)       exec neuronix-power-settings ;;
	printers)    exec system-config-printer ;;
	disks)       exec gparted ;;
	advanced)    exec dconf-editor ;;
	*)           exit 0 ;;
esac
