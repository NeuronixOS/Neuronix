#!/bin/sh
# Single-token Waybar on-click helpers. Waybar kills the click process group
# when this script exits, so long-lived UIs are detached.
set -eu

export PATH="${HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"
_uid="$(id -u)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${_uid}}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

if [ -z "${NEURONIX_CLICK_XY:-}" ]; then
	NEURONIX_CLICK_XY="$(/usr/bin/hyprctl cursorpos 2>/dev/null | tr -d ' ' || true)"
	export NEURONIX_CLICK_XY
fi

_quick() {
	# GNOME-style Sound / Network panels under the Waybar click.
	_py=""
	if [ -f "${HOME}/.local/share/neuronix/neuronix_quick_settings.py" ]; then
		_py="${HOME}/.local/share/neuronix/neuronix_quick_settings.py"
	elif [ -f /usr/share/neuronix/neuronix_quick_settings.py ]; then
		_py=/usr/share/neuronix/neuronix_quick_settings.py
	fi
	if [ -n "${_py}" ]; then
		# Detach so waybar cannot kill the panel when the click handler returns.
		if command -v systemd-run >/dev/null 2>&1; then
			systemd-run --user --collect --quiet \
				--property=KillMode=process \
				--setenv="NEURONIX_CLICK_XY=${NEURONIX_CLICK_XY}" \
				--setenv="PATH=${PATH}" \
				--setenv="WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" \
				--setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}" \
				--setenv="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
				--setenv="DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}" \
				--setenv="DISPLAY=${DISPLAY:-}" \
				--setenv="HOME=${HOME}" \
				-- python3 "${_py}" "$1"
			return 0
		fi
		setsid -f env NEURONIX_CLICK_XY="${NEURONIX_CLICK_XY}" python3 "${_py}" "$1" >/dev/null 2>&1 || true
		return 0
	fi
	return 1
}

_hub() {
	# One centered window: section list on the left, the clicked menu on the right.
	command -v neuronix-settings >/dev/null 2>&1 || return 1
	if command -v systemd-run >/dev/null 2>&1; then
		systemd-run --user --collect --quiet \
			--property=KillMode=process \
			--setenv="NEURONIX_CLICK_XY=${NEURONIX_CLICK_XY:-}" \
			--setenv="PATH=${PATH}" \
			--setenv="WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" \
			--setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}" \
			--setenv="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
			--setenv="DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}" \
			--setenv="DISPLAY=${DISPLAY:-}" \
			--setenv="HOME=${HOME}" \
			-- neuronix-settings "$@"
		return 0
	fi
	setsid -f neuronix-settings "$@" >/dev/null 2>&1 || true
	return 0
}

case "${1:-}" in
	volume|sound|audio|pulse)
		# Open Sound already on the volume slider, not the Volume/Output menu.
		_hub sound volume && exit 0
		_quick sound && exit 0
		# Fallback: Sound page in the Waybar settings window.
		if command -v systemd-run >/dev/null 2>&1; then
			systemd-run --user --collect --quiet \
				--property=KillMode=process \
				--setenv="PATH=${PATH}" \
				--setenv="WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" \
				--setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}" \
				--setenv="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
				--setenv="DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}" \
				--setenv="DISPLAY=${DISPLAY:-}" \
				--setenv="HOME=${HOME}" \
				-- neuronix-settings sound
			exit 0
		fi
		setsid -f neuronix-settings sound >/dev/null 2>&1 || true
		exit 0
		;;
	network|wifi|nm)
		_hub network && exit 0
		_quick network && exit 0
		# Fallback: Wi-Fi page in the Waybar settings window.
		if command -v systemd-run >/dev/null 2>&1; then
			systemd-run --user --collect --quiet \
				--property=KillMode=process \
				--setenv="PATH=${PATH}" \
				--setenv="WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" \
				--setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}" \
				--setenv="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
				--setenv="DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}" \
				--setenv="DISPLAY=${DISPLAY:-}" \
				--setenv="HOME=${HOME}" \
				-- neuronix-settings wifi
			exit 0
		fi
		setsid -f neuronix-settings wifi >/dev/null 2>&1 || true
		exit 0
		;;
	datetime|clock|calendar)
		_hub datetime calendar && exit 0
		if command -v systemd-run >/dev/null 2>&1; then
			systemd-run --user --collect --quiet \
				--property=KillMode=process \
				--setenv="PATH=${PATH}" \
				--setenv="WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" \
				--setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}" \
				--setenv="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
				--setenv="DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}" \
				--setenv="DISPLAY=${DISPLAY:-}" \
				--setenv="HOME=${HOME}" \
				-- neuronix-settings datetime calendar
			exit 0
		fi
		setsid -f neuronix-settings datetime calendar >/dev/null 2>&1 || true
		exit 0
		;;
	cpu)
		_hub system && exit 0
		_quick cpu && exit 0
		if command -v neuronix-btop >/dev/null 2>&1; then
			exec neuronix-btop
		fi
		echo "neuronix-btop is not installed" >&2
		exit 1
		;;
	memory|ram|mem)
		_hub system && exit 0
		_quick memory && exit 0
		if command -v neuronix-btop >/dev/null 2>&1; then
			exec neuronix-btop
		fi
		echo "neuronix-btop is not installed" >&2
		exit 1
		;;
	btop | cpu-btop | memory-btop)
		if command -v neuronix-btop >/dev/null 2>&1; then
			exec neuronix-btop
		fi
		echo "neuronix-btop is not installed" >&2
		exit 1
		;;
	battery)
		_hub system && exit 0
		if command -v systemd-run >/dev/null 2>&1; then
			systemd-run --user --collect --quiet \
				--property=KillMode=process \
				--setenv="PATH=${PATH}" \
				--setenv="WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" \
				--setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}" \
				--setenv="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
				--setenv="DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}" \
				--setenv="DISPLAY=${DISPLAY:-}" \
				--setenv="HOME=${HOME}" \
				-- neuronix-settings system
			exit 0
		fi
		setsid -f neuronix-settings system >/dev/null 2>&1 || true
		exit 0
		;;
	power | session)
		_hub power && exit 0
		_quick power && exit 0
		if command -v systemd-run >/dev/null 2>&1; then
			systemd-run --user --collect --quiet \
				--property=KillMode=process \
				--setenv="PATH=${PATH}" \
				--setenv="WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" \
				--setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}" \
				--setenv="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
				--setenv="DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}" \
				--setenv="DISPLAY=${DISPLAY:-}" \
				--setenv="HOME=${HOME}" \
				-- neuronix-session-action shutdown
			exit 0
		fi
		setsid -f neuronix-session-action shutdown >/dev/null 2>&1 || true
		exit 0
		;;
	settings)
		# Detach: waybar kills the click process group when this script exits.
		if command -v systemd-run >/dev/null 2>&1; then
			systemd-run --user --collect --quiet \
				--property=KillMode=process \
				--setenv="PATH=${PATH}" \
				--setenv="WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" \
				--setenv="XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}" \
				--setenv="HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" \
				--setenv="DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}" \
				--setenv="DISPLAY=${DISPLAY:-}" \
				--setenv="HOME=${HOME}" \
				-- neuronix-settings system
			exit 0
		fi
		setsid -f neuronix-settings system >/dev/null 2>&1 || true
		exit 0
		;;
	menu)
		if pgrep -x fuzzel >/dev/null 2>&1; then
			pkill -x fuzzel || true
			exit 0
		fi
		exec fuzzel --anchor top-left --x-margin 8 --y-margin 40
		;;
	*)
		echo "Usage: neuronix-waybar-click volume|network|cpu|memory|btop|battery|power|settings|menu" >&2
		exit 1
		;;
esac
