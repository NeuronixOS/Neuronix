#!/usr/bin/env python3
"""Launch (or toggle) a window hung under the Waybar module that was just clicked.

A second click of the same module closes the existing popover instead of
stacking another. Waybar kills the on-click process group when the handler
returns, so this detaches via systemd-run/setsid before waiting on the new
window.
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import time


def _hypr_json(args: list[str]):
    return json.loads(subprocess.check_output(args, text=True, timeout=2))


def _hypr_cursor_xy() -> tuple[int, int] | None:
    env = (os.environ.get("NEURONIX_CLICK_XY") or "").replace(" ", "")
    if env and "," in env:
        try:
            a, b = env.split(",", 1)
            return int(a), int(b)
        except Exception:
            pass
    try:
        pos = subprocess.check_output(["hyprctl", "cursorpos"], text=True, timeout=1).strip()
        parts = [p.strip() for p in pos.split(",")]
        return int(parts[0]), int(parts[1])
    except Exception:
        return None


def _snapshot_click() -> None:
    if os.environ.get("NEURONIX_CLICK_XY"):
        return
    cur = _hypr_cursor_xy()
    if cur is not None:
        os.environ["NEURONIX_CLICK_XY"] = f"{cur[0]},{cur[1]}"


def _clients() -> list[dict]:
    try:
        return _hypr_json(["hyprctl", "clients", "-j"])
    except Exception:
        return []


def _matches(c: dict, needle: str) -> bool:
    n = needle.lower()
    cls = str(c.get("class") or "").lower()
    initial = str(c.get("initialClass") or "").lower()
    title = str(c.get("title") or "").lower()
    initial_title = str(c.get("initialTitle") or "").lower()
    return (
        n in cls
        or n in initial
        or cls == n
        or initial == n
        or n in title
        or n in initial_title
    )


def _waybar_height(mon_name: str, fallback: int = 32) -> int:
    try:
        layers = _hypr_json(["hyprctl", "layers", "-j"])
        info = layers.get(mon_name) or {}
        for level in (info.get("levels") or {}).values():
            for surf in level:
                if surf.get("namespace") == "waybar":
                    return max(int(surf.get("h") or fallback), 1)
    except Exception:
        pass
    return fallback


def _popover_xy(width: int, height: int) -> tuple[int, int]:
    # Sit clearly below Waybar + hyprbars titlebar so − □ × stay clickable, and
    # bias left of the click so the right-side close control is not clipped.
    BELOW_BAR = 56
    LEFT_BIAS = 96
    cur = _hypr_cursor_xy()
    if cur is None:
        return 80, 80
    x, y = cur
    try:
        monitors = _hypr_json(["hyprctl", "monitors", "-j"])
    except Exception:
        return max(8, x - width // 2 - LEFT_BIAS), y + BELOW_BAR
    mon = None
    for m in monitors:
        mx, my = int(m.get("x", 0)), int(m.get("y", 0))
        mw, mh = int(m.get("width", 0)), int(m.get("height", 0))
        # Portrait transforms report panel WxH; layout span swaps.
        tr = int(m.get("transform") or 0)
        if tr in (1, 3, 5, 7):
            mw, mh = mh, mw
        if mx <= x < mx + mw and my <= y < my + mh:
            mon = m
            break
    if mon is None:
        return max(8, x - width // 2 - LEFT_BIAS), y + BELOW_BAR
    mx, my = int(mon.get("x", 0)), int(mon.get("y", 0))
    mw, mh = int(mon.get("width", 0)), int(mon.get("height", 0))
    tr = int(mon.get("transform") or 0)
    if tr in (1, 3, 5, 7):
        mw, mh = mh, mw
    bar_h = _waybar_height(str(mon.get("name") or ""), 32)
    left = int(x - width / 2) - LEFT_BIAS
    left = max(mx + 8, min(left, mx + mw - width - 8))
    if (y - my) <= max(bar_h + 48, 80):
        top = my + bar_h + BELOW_BAR
        if top + height > my + mh - 8:
            top = max(my + bar_h + BELOW_BAR, my + mh - height - 8)
        return left, top
    return left, y + BELOW_BAR


def _dispatch(name: str, arg: str = "") -> None:
    cmd = ["hyprctl", "dispatch", name]
    if arg:
        cmd.append(arg)
    subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL)


def _place(addr: str, width: int | None, height: int | None) -> None:
    c = next((x for x in _clients() if x.get("address") == addr), None)
    size = (c.get("size") or [640, 420]) if c else [640, 420]
    ww = int(width or size[0] or 640)
    hh = int(height or size[1] or 420)
    _dispatch("tagwindow", f"+waybar-popover address:{addr}")
    _dispatch("setfloating", f"address:{addr}")
    if width and height:
        _dispatch("resizewindowpixel", f"exact {ww} {hh},address:{addr}")
        time.sleep(0.05)
    x, y = _popover_xy(ww, hh)
    _dispatch("movewindowpixel", f"exact {x} {y},address:{addr}")
    _dispatch("focuswindow", f"address:{addr}")


def _pin(addr: str, width: int | None, height: int | None) -> None:
    _place(addr, width, height)
    for delay in (0.12, 0.28):
        time.sleep(delay)
        _place(addr, width, height)


def _find_class(needle: str) -> dict | None:
    for c in _clients():
        if _matches(c, needle):
            return c
    return None


def _process_running(klass: str) -> bool:
    n = (klass or "").lower()
    if "btop" in n or "org.neuronix.btop" in n:
        return subprocess.run(["pgrep", "-x", "btop"], stdout=subprocess.DEVNULL).returncode == 0
    return False


def _launch_lock(klass: str):
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    os.makedirs(runtime, exist_ok=True)
    key = re.sub(r"[^a-z0-9]+", "-", (klass or "app").lower()).strip("-") or "app"
    path = os.path.join(runtime, f"neuronix-popover-{key}.lock")
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        try:
            os.close(fd)
        except Exception:
            pass
        return None
    return fd


def _relaunch_detached(argv: list[str]) -> None:
    """Leave Waybar's click process group so the app is not killed on return."""
    if os.environ.get("NEURONIX_POPOVER_DETACHED") == "1":
        return
    _snapshot_click()
    os.environ["NEURONIX_POPOVER_DETACHED"] = "1"
    self = os.path.abspath(sys.argv[0])
    env_keys = (
        "WAYLAND_DISPLAY",
        "XDG_RUNTIME_DIR",
        "HYPRLAND_INSTANCE_SIGNATURE",
        "DBUS_SESSION_BUS_ADDRESS",
        "DISPLAY",
        "PATH",
        "HOME",
        "NEURONIX_CLICK_XY",
        "NEURONIX_POPOVER_DETACHED",
        "XDG_CURRENT_DESKTOP",
    )
    run = [
        "systemd-run",
        "--user",
        "--collect",
        "--quiet",
        "--property=KillMode=process",
    ]
    for key in env_keys:
        val = os.environ.get(key)
        if val:
            run.append(f"--setenv={key}={val}")
    run.extend(["--", sys.executable, self, *argv])
    try:
        r = subprocess.run(run, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if r.returncode == 0:
            raise SystemExit(0)
    except FileNotFoundError:
        pass
    subprocess.Popen(
        [sys.executable, self, *argv],
        start_new_session=True,
        env=os.environ.copy(),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    raise SystemExit(0)


def main(argv: list[str] | None = None) -> int:
    raw = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--class", dest="klass", default="", help="Window class/title substring")
    parser.add_argument("--width", type=int, default=0)
    parser.add_argument("--height", type=int, default=0)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args(raw)
    cmd = list(args.command)
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        parser.error("missing command")

    _snapshot_click()

    if os.environ.get("NEURONIX_POPOVER_DETACHED") != "1" and args.klass:
        existing = _find_class(args.klass)
        if existing and existing.get("address"):
            _dispatch("closewindow", f"address:{existing['address']}")
            return 0

    _relaunch_detached(raw)
    _snapshot_click()

    lock = _launch_lock(args.klass) if args.klass else None
    if args.klass and lock is None:
        existing = _find_class(args.klass)
        if existing and existing.get("address"):
            _dispatch("closewindow", f"address:{existing['address']}")
        return 0
    proc = None
    try:
        if args.klass:
            existing = _find_class(args.klass)
            if existing and existing.get("address"):
                _dispatch("closewindow", f"address:{existing['address']}")
                return 0
            if _process_running(args.klass):
                time.sleep(0.15)
                existing = _find_class(args.klass)
                if existing and existing.get("address"):
                    _dispatch("closewindow", f"address:{existing['address']}")
                    return 0

        before = {c.get("address") for c in _clients()}
        proc = subprocess.Popen(cmd, start_new_session=True)
        addr = None
        deadline = time.time() + 8.0
        while time.time() < deadline:
            time.sleep(0.08)
            for c in _clients():
                a = c.get("address")
                if not a or a in before:
                    continue
                if args.klass and not _matches(c, args.klass):
                    continue
                addr = a
                break
            if addr:
                break
        if addr:
            _pin(addr, args.width or None, args.height or None)
    finally:
        if lock is not None:
            try:
                fcntl.flock(lock, fcntl.LOCK_UN)
                os.close(lock)
            except Exception:
                pass
    if proc is not None:
        proc.wait()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
