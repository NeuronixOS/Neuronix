# Neuronix CAVA defaults (SDL window). Override with ~/.config/cava/config.

[general]
framerate = 60
bars = 56
autosens = 1
sensitivity = 50
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = pulse
source = auto

[output]
method = sdl
orientation = bottom
channels = stereo
sdl_width = 960
sdl_height = 360
sdl_x = -1
sdl_y = -1
sdl_full_screen = 0

[color]
background = '#2e2e2e'
gradient = 1
gradient_color_1 = '#801010'
gradient_color_2 = '#e02020'
gradient_color_3 = '#f08080'

[smoothing]
monstercat = 1
waves = 0
gravity = 100
