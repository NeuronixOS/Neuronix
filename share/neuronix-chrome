#!/usr/bin/env bash
# Launch Google Chrome with Neuronix unpacked extensions (if staged).
#
# Chrome 137+ ignores --load-extension unless DisableLoadExtensionCommandLineSwitch
# is turned off. External Extensions (CRX) from register-chrome-extensions.sh
# still apply after a full Chrome restart.
set -euo pipefail
EXT_ROOT="/usr/share/neuronix/browser-extensions"
LOAD_ARGS=()
if [[ -d "$EXT_ROOT" ]]; then
	shopt -s nullglob
	for d in "$EXT_ROOT"/*/; do
		[[ -f "$d/manifest.json" ]] || continue
		LOAD_ARGS+=("$(realpath "$d")")
	done
	shopt -u nullglob
fi
CHROME=""
for c in google-chrome-stable google-chrome; do
	if command -v "$c" >/dev/null 2>&1; then
		CHROME="$c"
		break
	fi
done
if [[ -z "$CHROME" ]]; then
	echo "neuronix-chrome: Google Chrome not found in PATH" >&2
	exit 1
fi
# Re-enable --load-extension (Chrome 137+). Harmless on older builds.
EXTRA=(--disable-features=DisableLoadExtensionCommandLineSwitch)
if [[ ${#LOAD_ARGS[@]} -gt 0 ]]; then
	IFS=,
	exec "$CHROME" "${EXTRA[@]}" --load-extension="${LOAD_ARGS[*]}" "$@"
fi
exec "$CHROME" "$@"
